{
  "rules": {
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('nick').isString() && newData.child('nick').val().length <= 12 && newData.child('x').isNumber() && newData.child('y').isNumber())"
      }
    },
    "readers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('nick').isString() && newData.child('nick').val().length <= 12)"
      }
    }
  }
}
